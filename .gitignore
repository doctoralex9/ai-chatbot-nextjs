# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
long-term-plan.md

# screenshots & playwright output
/screenshots
/.playwright-mcp

# IDE
.vscode/
.idea/
*.suo
*.user

# personal backup — not for template buyers
/_betsense-backup/

# internal project files — not for template buyers
/CLAUDE.md
/MASTER_UI_PROMPT.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# api keys (already covered by .env* above — explicit for clarity)
.env.local
.env.*.local